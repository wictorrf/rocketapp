# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave com privilégios de administrador — ignora RLS. Usada só em código
# server-side (ex: exclusão de conta). NUNCA expor com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
